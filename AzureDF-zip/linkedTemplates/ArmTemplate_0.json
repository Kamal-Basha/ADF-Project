		"ls_zipfrominput_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_zipfrominput'"
		},
		"ls_zipped_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_zipped'"
		},
		"ls_sinktozipped_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_sinktozipped'"
		},
		"ls_sinkto zipped_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_sinkto zipped'"
		},
		"ls_inputstg_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://zipadf.dfs.core.windows.net/"
		},
		"ls_sinktooutput2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://zipadf.dfs.core.windows.net/"
		},
		"ls_zipfrominput_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://zipadf.dfs.core.windows.net/"
		},
		"ls_zipped_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://zipadf.dfs.core.windows.net/"
		},
		"ls_sinktozipped_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://zipadf.dfs.core.windows.net/"
		},
		"ls_sinkto zipped_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://zipadf.dfs.core.windows.net/"
		}
	},
