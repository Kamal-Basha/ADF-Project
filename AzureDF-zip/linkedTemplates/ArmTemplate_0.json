						},
						"fileSystem": "output"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_inputstg')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_zippedtozipped')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_zipped",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Binary",
